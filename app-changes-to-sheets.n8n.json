    {
      "id": "bd09f676-5252-550b-887f-da77266b046f",
      "name": "Prepare rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c=$('Configuration').first().json,a=c.actorInput;\nconst run=$('Check run status').first().json,health=$('Get HEALTH').first().json;\nconst items=$input.first().json.body;\nif (!Array.isArray(items)||health.apps+health.reviewRows!==items.length||items.length>a.maxItems||!Array.isArray(health.failed)||health.failed.length||health.blockedResponses>0||health.chargeLimitReached===true||run.stats?.restartCount>0) throw new Error('Incomplete or unreliable source response. Inspect HEALTH and APPS in the run; no rows written.');\nconst seen=new Set(),now=new Date().toISOString(),plain=v=>String(v??''),json=v=>v==null?'':JSON.stringify(v);\nconst rows=items.map(r=>{\n if (r.recordType!=='app'||typeof r.id!=='string'||!r.id||!r.name||!/^https?:\\/\\//i.test(r.url||'')||seen.has(r.id)) throw new Error('Unexpected record or duplicate app ID; no rows written.');\n seen.add(r.id);\n return {id:r.id,store:plain(r.store),appId:plain(r.appId),country:plain(r.country),name:plain(r.name),developer:plain(r.developer),category:plain(r.category),version:plain(r.version),lastUpdated:plain(r.lastUpdated),price:plain(r.price),currency:plain(r.currency),ratingAverage:plain(r.ratingAverage),ratingCount:plain(r.ratingCount),ranks:json(r.ranks),changeType:plain(r.changeType),changes:Array.isArray(r.changes)?r.changes.join(' | '):'',diff:json(r.diff),url:r.url,savedAt:now,runId:run.id};\n});\nconst events=rows.filter(r=>r.changeType==='CHANGED'||r.changeType==='REMOVED').map(r=>({eventKey:r.id+'|'+run.id,id:r.id,name:r.name,store:r.store,country:r.country,changeType:r.changeType,changes:r.changes,diff:r.diff,savedAt:r.savedAt,runId:r.runId}));\nreturn [{json:{rows,events,runId:run.id,observedRows:items.length,atLimit:items.length>=a.maxItems}}];"
      }
    },

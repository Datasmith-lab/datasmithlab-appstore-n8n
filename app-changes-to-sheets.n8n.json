    {
      "id": "31eb1a5b-b9ff-51b8-a6e2-8578a4fcbd61",
      "name": "Check run status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json.data;\nif (!r?.id) throw new Error('Missing Apify run response.');\nif (['FAILED','TIMED-OUT','ABORTED'].includes(r.status)) throw new Error(`Apify run ${r.id}: ${r.status}. Check its log.`);\nif (Date.now()-Date.parse($('Start Actor').first().json.data.startedAt)>15*60*1000)\n  throw new Error('Polling deadline reached. Inspect the existing Apify run before starting another.');\nreturn [{json:{...r,finished:r.status==='SUCCEEDED'}}];"
      }
    },

    {
      "id": "7843799b-4364-5ab2-9594-0fd56537da6c",
      "name": "Configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{json:{\n spreadsheetId:'REPLACE_WITH_SPREADSHEET_ID',\n maxTotalChargeUsd:0.10,\n actorInput:{appStoreApps:['389801252'],googlePlayApps:['com.instagram.android'],countries:['us'],chartLists:[],chartTopN:0,\n onlyNewOrChanged:true,ratingChangeThreshold:0.05,rankChangeThreshold:5,reviews:'off',maxItems:50}\n}}];"
      }
    },
    {
      "id": "8f7a5421-a6be-5941-8835-2d123897f9ab",
      "name": "Validate configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c=$input.first().json,a=c.actorInput;\nif (!c.spreadsheetId || c.spreadsheetId.startsWith('REPLACE_')) throw new Error('Set spreadsheetId.');\nconst list=v=>Array.isArray(v)?v:[];\nconst ios=list(a.appStoreApps),play=list(a.googlePlayApps);\nif (ios.some(x=>typeof x!=='string'||!x.trim())||play.some(x=>typeof x!=='string'||!x.trim())||new Set(ios).size!==ios.length||new Set(play).size!==play.length) throw new Error('Use distinct, non-empty App Store ids/links and Google Play package names.');\nif (ios.length+play.length<1||ios.length+play.length>25) throw new Error('Track 1 to 25 apps.');\nconst countries=list(a.countries);\nif (countries.length<1||countries.length>5||countries.some(x=>!/^[a-z]{2}$/.test(x))||new Set(countries).size!==countries.length) throw new Error('Use 1 to 5 distinct two-letter country codes, for example us.');\nif (a.onlyNewOrChanged!==true) throw new Error('This starter needs onlyNewOrChanged true so each run returns only new or changed apps.');\nif (a.reviews!=='off') throw new Error('Review rows are not stored by this starter. Keep reviews off.');\nif (!list(a.chartLists).every(x=>['top-free','top-paid'].includes(x))) throw new Error('chartLists may contain top-free and top-paid only.');\nif (!Number.isInteger(a.chartTopN)||a.chartTopN<0||a.chartTopN>20) throw new Error('Use chartTopN 0 to 20.');\nif (!Number.isInteger(a.maxItems)||a.maxItems<1||a.maxItems>200) throw new Error('Use maxItems 1 to 200.');\nif (!Number.isFinite(c.maxTotalChargeUsd)||c.maxTotalChargeUsd<=0||c.maxTotalChargeUsd>1) throw new Error('Set a run charge cap above zero and no more than $1.');\nreturn [{json:c}];"
      }
    },

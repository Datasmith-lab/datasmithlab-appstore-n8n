      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "url": "={{ 'https://api.apify.com/v2/actor-runs/'+$('Start Actor').first().json.data.id+'?waitForFinish=60' }}",

      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        4180,
        300
      ],
      "parameters": {
        "content": "## App Store + Google Play changes to Sheets\nConfigure your own credentials and two tabs: Apps and Changes (header rows included).\nFirst run: every app is NEW (baseline). Later runs return only new or changed apps.\nApps = latest state per app, store and country. Changes = one row per app per run with a version, price, rating, rank change or removal.\nIf a run succeeded on Apify but the Sheet write failed, set onlyNewOrChanged to false for one run to refresh Apps; events from that run are not recreated.\n$0.10 Actor run cap. Daily 09:00 UTC; one execution at a time.",
        "height": 400,
        "width": 580
      }
    }
